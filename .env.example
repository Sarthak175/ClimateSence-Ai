# ---------- Backend (backend/.env or Render dashboard) ----------
# Comma-separated list of allowed frontend origins (your Vercel URL)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Optional regex to also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app
# Secret shared with the ESP32 (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
DEVICE_TOKEN=change-me
# Where trained artifacts live (default: backend/models)
# MODEL_DIR=backend/models
LIVE_CACHE_TTL_S=300
CLIMATE_CACHE_TTL_S=21600

# ---------- Frontend (frontend/.env.local or Vercel dashboard) ----------
# Public URL of the backend. This is NOT a secret.
VITE_API_BASE_URL=http://localhost:8000
